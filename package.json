{
  "name": "broadcaster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "pnpm -r type-check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "fix": "pnpm run /.+:fix/"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.4.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0"
}
